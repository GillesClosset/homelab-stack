# Finance Dashboard
# Protected by Cloudflare Access (Google OAuth). Because finance is the only
# proxied (orange-cloud) host while every other service is DNS-only, port 443
# stays open to the internet — so we must reject any request that does NOT come
# from a Cloudflare edge IP, otherwise the (largely unauthenticated) /api/*
# data routes are reachable by hitting the VPS IP directly and bypassing Access.
# Cloudflare IP ranges: https://www.cloudflare.com/ips-v4 + /ips-v6
finance.chezgilles.ovh {
    @not_cloudflare not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
    handle @not_cloudflare {
        respond "Forbidden" 403
    }

    handle {
        # Proxy API requests to backend
        reverse_proxy /api/* finance_backend:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote}
            header_up X-Forwarded-For {remote}
            header_up X-Forwarded-Proto {scheme}
        }

        # Proxy auth requests to backend
        reverse_proxy /auth/* finance_backend:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote}
            header_up X-Forwarded-For {remote}
            header_up X-Forwarded-Proto {scheme}
        }

        # Legacy assistant path: Open WebUI was removed from the runtime.
        # Redirect old finance links to the native assistant route.
        redir /open-webui /assistant 308
        redir /open-webui/* /assistant 308

        # Everything else goes to frontend (nginx serving React build)
        reverse_proxy finance_frontend:80
    }
}



