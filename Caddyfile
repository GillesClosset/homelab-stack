# Finance Dashboard
finance.chezgilles.ovh {
    # Proxy API requests to backend
    reverse_proxy /api/* finance_backend:8000 {
        header_up Host {host}
        header_up X-Real-IP {remote}
        header_up X-Forwarded-For {remote}
        header_up X-Forwarded-Proto {scheme}
    }

    # Proxy auth requests to backend
    reverse_proxy /auth/* finance_backend:8000 {
        header_up Host {host}
        header_up X-Real-IP {remote}
        header_up X-Forwarded-For {remote}
        header_up X-Forwarded-Proto {scheme}
    }

    # Proxy Open WebUI so it can be framed without mixed-content
    # Use handle_path to strip the /open-webui prefix so the backend sees
    # requests at its root (/) which Open WebUI expects.
    handle_path /open-webui* {
        reverse_proxy open-webui:8080 {
            header_up Host {host}
            header_up X-Real-IP {remote}
            header_up X-Forwarded-For {remote}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Everything else goes to frontend (nginx serving React build)
    reverse_proxy finance_frontend:80
}



